# Default: let git handle text normalization automatically.
* text=auto

# Shell scripts and Dockerfiles must be LF, otherwise Linux containers
# fail with `exec ...: no such file or directory` due to \r in shebang.
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Windows-only utility scripts — cmd/PowerShell parser ламається на LF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Lock files — LF + виключити з git diff (auto-regen — тисячі noise-рядків
# на кожен `uv lock`/`npm install`; reproducibility гарантує сам файл).
uv.lock           text eol=lf -diff
package-lock.json text eol=lf -diff
pnpm-lock.yaml    text eol=lf -diff

# Generated code — не рахується у GitHub linguist stats + collapse у PR diff.
app/grpc_generated/**  linguist-generated=true
web/src/gen/**         linguist-generated=true

# Mermaid sources — text; SVG-output може бути великим bundled XML, але
# текстовий формат → diff readable.
*.mmd   text eol=lf
*.svg   text

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary

# Audio (TTS output, STT samples) — binary.
*.opus  binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.m4a   binary