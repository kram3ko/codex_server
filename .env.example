# =============================================================================
# Codex CLI sidecar runtime
# =============================================================================
# Локально (uvicorn на хості): ws://localhost:4500. У docker-compose override-
# нуто на ws://codex-cli:4500 / ws://codex-cli-guest:4500.
CODEX_CLI_URL=ws://localhost:4500
CODEX_CLI_GUEST_URL=ws://codex-cli-guest:4500
CODEX_CWD=/home/codex/workspace
CODEX_APPROVAL_POLICY=never
CODEX_SANDBOX=danger-full-access
CODEX_REQUEST_TIMEOUT_SECONDS=420
CODEX_THREAD_REUSE_ENABLED=true
CODEX_REASONING_EFFORT=medium

# WS handshake auth (CLI 0.131+ обов'язково). HS256 signed-bearer-token,
# per-audience secrets — leak admin не дає доступу до guest і навпаки.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CODEX_WS_SECRET_ADMIN=
CODEX_WS_SECRET_GUEST=

# =============================================================================
# Speech & TTS APIs
# =============================================================================
# SPEECHMATICS_LANGUAGE: auto (Language Identification) | uk | ru | en | de | ...
SPEECHMATICS_API_KEY=
SPEECHMATICS_LANGUAGE=auto
SPEECHMATICS_OPERATING_POINT=enhanced

# Google Cloud Console → Text-to-Speech API enabled.
GOOGLE_TTS_API_KEY=

# =============================================================================
# Storage backends
# =============================================================================
# Postgres
POSTGRES_PASSWORD=codex
DATABASE_URL=postgresql+asyncpg://codex:codex@localhost:5432/codex

# Redis — REDIS_PASSWORD має співпадати з паролем у REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGEME@localhost:6379/0

# MinIO (S3-compatible). У docker — http://minio:9000.
# S3_PUBLIC_ENDPOINT: same-origin proxy у compose (`/minio`).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=personal-codex
S3_REGION=us-east-1

# =============================================================================
# Telegram bot
# =============================================================================
# @BotFather → token. TG_ADMIN_USER_IDS — comma-separated user_ids,
# auto-promote до ADMIN на першому контакті (shell + file_change tools).
TG_BOT_TOKEN=123456:ABC-DEF
TG_ADMIN_USER_IDS=

# =============================================================================
# Web auth (email + password → JWT)
# =============================================================================
# Bootstrap admin: створюється/синхронізується юзер з цим email,
# password_hash = argon2id(ADMIN_PASSWORD). JWT_SECRET підписує access JWT.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
JWT_SECRET=

# =============================================================================
# MCP bridge (Codex CLI ↔ FastAPI tools)
# =============================================================================
# Bearer для /mcp/streamable. Generate: openssl rand -hex 32.
MCP_CALLBACK_TOKEN=
# HS256 secret для per-turn JWT у prompt-header (MCPAuthz).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_AUTHZ_SECRET=

# =============================================================================
# Gunicorn HTTP runtime
# =============================================================================
GUNICORN_WORKERS=2
GUNICORN_PRELOAD=true

# =============================================================================
# Production deploy (Dokploy + Traefik)
# =============================================================================
DOMAIN=codex.your-domain.com
BUGSINK_DOMAIN=bugsink.your-domain.com
BUGSINK_DB_PASSWORD=bugsink

# =============================================================================
# Git remote ops (codex-cli sidecar)
# =============================================================================
GH_TOKEN=
GITLAB_TOKEN=
GIT_AUTHOR_NAME=Codex Agent
GIT_AUTHOR_EMAIL=codex@local

# =============================================================================
# Observability — Bugsink (self-hosted, UI :8089) + Sentry SDK
# =============================================================================
# Bugsink ingest token: openssl rand -hex 20 (40-hex per Bugsink regex).
# SENTRY_DSN empty → sentry-sdk no-op. VITE_* — build-time constants для Vite.
# SENTRY_RELEASE / VITE_SENTRY_RELEASE: git sha → group-by-release.
# SENTRY_TRACES_SAMPLE_RATE > 0 → performance traces.
BUGSINK_AUTH_TOKEN=
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_TRACES_SAMPLE_RATE=0
