# --- Codex CLI app-server ---
# Auth via mounted .codex/auth.json (ChatGPT/Codex subscription).
# Локально (uvicorn на хості):       ws://localhost:4500  ← але порт у docker-compose не публікується
# У docker-compose (сервіс=codex-server): ws://codex-cli:4500 (override через docker-compose.yml)
CODEX_CLI_URL=ws://localhost:4500
# Окремий sidecar для не-admin TG-юзерів (профіль `guest` у docker-compose).
# Setup: mkdir .codex-guest && docker compose --profile guest run --rm
# codex-cli-guest codex login → потім `--profile guest up -d`.
CODEX_CLI_GUEST_URL=ws://codex-cli-guest:4500
CODEX_CWD=/home/codex/workspace
CODEX_APPROVAL_POLICY=never
CODEX_SANDBOX=danger-full-access
CODEX_REQUEST_TIMEOUT_SECONDS=420

# --- Speech-to-text (Speechmatics batch v2) ---
# language: auto (Language Identification) | uk | ru | en | de | ...
SPEECHMATICS_API_KEY=
SPEECHMATICS_LANGUAGE=auto
SPEECHMATICS_OPERATING_POINT=enhanced

# --- Text-to-speech (Google Cloud TTS) ---
# API key з Google Cloud Console (Text-to-Speech API enabled).
GOOGLE_TTS_API_KEY=

# --- Postgres ---
# Локально (uvicorn на хості): localhost:5432
# У docker:                    postgres:5432 (override через docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://codex:codex@localhost:5432/codex

# --- Redis ---
# Локально: localhost:6379. У docker: redis:6379 (override через docker-compose.yml).
# REDIS_PASSWORD => `--requirepass`. Має співпадати з тим, що зашитий у REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGEME@localhost:6379/0

# --- Object storage (MinIO, S3-compatible) ---
# Локально: http://localhost:9000
# У docker: http://minio:9000 (override через docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=personal-codex
S3_REGION=us-east-1

# --- Telegram bot ---
# Create token via @BotFather.
TG_BOT_TOKEN=123456:ABC-DEF
# Bootstrap-only: TG user_ids що отримають UserRole.ADMIN при першому create
# (`UserService.get_or_create_by_tg`) + idempotent promote на startup. ADMIN
# може юзати /restart і shell/file_change Codex tools; решта (USER role) —
# тільки image_gen/web_search/mcp/view. Comma-separated: 12345,67890. Empty →
# нікого автоматично admin'ом не робимо.
TG_ADMIN_USER_IDS=

# --- Web chat auth (single bearer token) ---
# Generate: openssl rand -hex 32
WEB_API_TOKEN=

# --- MCP (Codex CLI ↔ FastAPI tools bridge) ---
# Bearer токен для streamable-HTTP MCP. Той самий рядок монтується в
# codex-cli (через docker-compose) та валідується settings'ом
# у FastAPI middleware. Generate: openssl rand -hex 32. Empty → MCP без
# auth (dev only).
MCP_CALLBACK_TOKEN=
