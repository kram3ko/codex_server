# --- LLM ---
OPENAI_API_KEY=sk-...

# --- Postgres ---
# Local docker-compose:  postgresql+asyncpg://codex:codex@postgres:5432/codex
# Neon (prod):           postgresql+asyncpg://user:pass@ep-xxx.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://codex:codex@localhost:5432/codex

# --- Object storage (MinIO, S3-compatible) ---
# Локальний docker-compose. У docker-мережі endpoint = http://minio:9000,
# ззовні (з host machine) — http://localhost:9000.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=personal-codex
S3_REGION=us-east-1

# --- Telegram bot ---
TG_BOT_TOKEN=123456:ABC-DEF
TG_ALLOWED_USER_ID=0

# --- Web chat auth (single bearer token) ---
# Generate: openssl rand -hex 32
WEB_API_TOKEN=
